# Settings for chess-coach. 
# Copy this file to .env and uncomment the lines you want to change. 
# Commented lines do nothing: the defaults in src/chess_coach/config.py apply.

# Chat model that writes the answers (fallback: qwen3:8b).
# CHAT_MODEL=qwen3.5:9b

# Embedding model that turns text into vectors (comparison: nomic-embed-text).
# EMBEDDING_MODEL=qwen3-embedding:0.6b

# Address of the local Ollama server.
# OLLAMA_BASE_URL=http://localhost:11434

# Context window in tokens (prompt + thinking + answer).
# NUM_CTX=8192

# Let the chat model think before answering: true or false.
# THINKING=false
